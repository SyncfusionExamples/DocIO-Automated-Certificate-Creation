<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Automated_Certificate_Creation</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Automated_Certificate_Creation.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Automated_Certificate_Creation</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <style>
        footer {
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(20px);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding: 30px 0;
            margin-top: auto;
        }

        .footer-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .footer-content {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 15px;
        }

        .footer-copyright {
            color: #94a3b8;
            font-size: 14px;
            font-weight: 600;
            text-align: center;
        }

        .footer-divider {
            color: rgba(148, 163, 184, 0.4);
            font-size: 14px;
        }

        .footer-content a {
            color: #60a5fa;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.3s ease;
            position: relative;
        }

            .footer-content a:hover {
                color: #93c5fd;
            }

            .footer-content a::after {
                content: '';
                position: absolute;
                bottom: -2px;
                left: 0;
                width: 0;
                height: 2px;
                background: linear-gradient(90deg, #3b82f6, #a855f7);
                transition: width 0.3s ease;
            }

            .footer-content a:hover::after {
                width: 100%;
            }

        .footer-tagline {
            color: #64748b;
            font-size: 13px;
            text-align: center;
            font-weight: 500;
        }

        @@media (max-width: 768px) {
            .footer-content {
                flex-direction: column;
                gap: 10px;
            }

            .footer-divider {
                display: none;
            }
        }
    </style>

    <footer>
        <div class="footer-container">
            <div class="footer-content">
                <span class="footer-copyright">&copy; 2026 EduCert</span>
                <span class="footer-divider">|</span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                <span class="footer-divider">|</span>
                <a href="https://help.syncfusion.com/document-processing/word/word-library/net/getting-started" target="_blank">Documentation</a>
            </div>
            <div class="footer-tagline">
                Automated Certificate Generation Tool
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
